<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="720.0" prefWidth="1080.0"
            styleClass="module-root summary-root"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.teach.javafx.controller.SystemSummaryController">
   <center>
      <ScrollPane fitToWidth="true" hbarPolicy="NEVER" pannable="true" styleClass="summary-scroll">
         <content>
            <VBox spacing="18.0" styleClass="summary-page">
               <children>
                  <VBox spacing="12.0" styleClass="summary-hero">
                     <children>
                        <Label text="教学管理系统" styleClass="summary-title" />
                        <Label wrapText="true" styleClass="summary-subtitle"
                               text="本系统是一个面向学校日常教学管理场景的综合业务平台，服务对象包括管理员、教师和学生三类用户。系统围绕人员信息、课程安排、成绩管理、作业提交、请假审批、校园社区、统计分析与智能问答等核心环节进行设计，目标是在同一套桌面客户端中完成基础数据维护、教学过程记录、师生协同和管理决策支持。" />
                        <HBox spacing="12.0" styleClass="summary-stat-row">
                           <children>
                              <VBox spacing="4.0" styleClass="summary-stat-block" HBox.hgrow="ALWAYS">
                                 <children>
                                    <Label text="3 类" styleClass="summary-kpi" />
                                    <Label text="管理员、教师、学生分角色使用" styleClass="summary-kpi-label" wrapText="true" />
                                 </children>
                              </VBox>
                              <VBox spacing="4.0" styleClass="summary-stat-block" HBox.hgrow="ALWAYS">
                                 <children>
                                    <Label text="12+" styleClass="summary-kpi green" />
                                    <Label text="覆盖教务、人员、互动与统计模块" styleClass="summary-kpi-label" wrapText="true" />
                                 </children>
                              </VBox>
                              <VBox spacing="4.0" styleClass="summary-stat-block" HBox.hgrow="ALWAYS">
                                 <children>
                                    <Label text="JavaFX" styleClass="summary-kpi amber" />
                                    <Label text="桌面端界面，统一深浅主题" styleClass="summary-kpi-label" wrapText="true" />
                                 </children>
                              </VBox>
                              <VBox spacing="4.0" styleClass="summary-stat-block" HBox.hgrow="ALWAYS">
                                 <children>
                                    <Label text="Spring Boot" styleClass="summary-kpi violet" />
                                    <Label text="后端接口与数据库持久化支撑" styleClass="summary-kpi-label" wrapText="true" />
                                 </children>
                              </VBox>
                           </children>
                        </HBox>
                     </children>
                  </VBox>

                  <HBox spacing="16.0">
                     <children>
                        <VBox spacing="10.0" styleClass="summary-panel" HBox.hgrow="ALWAYS">
                           <children>
                              <Label text="一、系统定位" styleClass="summary-section-title" />
                              <Label wrapText="true" styleClass="summary-text"
                                     text="教学管理系统以“学生培养全过程管理”为主线，将学生档案、教师信息、课程资源、成绩记录、作业过程、请假流转和统计分析集中到一个统一平台中。相比只保存静态表格的数据管理方式，本系统更强调业务过程：学生可以查看自己的信息、课程、作业和成绩；教师可以管理教学相关任务；管理员可以维护系统基础数据并监督整体运行情况。" />
                              <Label wrapText="true" styleClass="summary-text"
                                     text="系统采用前后端分离的思路组织代码。前端负责界面展示、表单输入、数据表格和用户交互；后端负责权限判断、业务规则、数据库读写和接口返回。这样既便于模块独立维护，也方便后续扩展更多教学场景。" />
                           </children>
                        </VBox>
                        <VBox spacing="10.0" styleClass="summary-panel" HBox.hgrow="ALWAYS">
                           <children>
                              <Label text="二、适用用户" styleClass="summary-section-title" />
                              <Label text="管理员" styleClass="summary-item-title" />
                              <Label wrapText="true" styleClass="summary-text" text="负责学生、教师、课程、菜单、字典、账号申请和基础业务数据的维护，是系统数据完整性和权限配置的主要管理者。" />
                              <Label text="教师" styleClass="summary-item-title" />
                              <Label wrapText="true" styleClass="summary-text" text="负责查看学生信息、处理请假申请、发布与批改作业、维护个人简介，并通过统计结果了解学生学习状态。" />
                              <Label text="学生" styleClass="summary-item-title" />
                              <Label wrapText="true" styleClass="summary-text" text="负责维护个人信息、查看课表和成绩、提交作业、发起请假申请、参与校园社区互动，并使用智能助手查询系统内信息。" />
                           </children>
                        </VBox>
                     </children>
                  </HBox>

                  <VBox spacing="12.0" styleClass="summary-panel">
                     <children>
                        <Label text="三、核心功能模块" styleClass="summary-section-title" />
                        <HBox spacing="16.0">
                           <children>
                              <VBox spacing="8.0" HBox.hgrow="ALWAYS">
                                 <children>
                                    <Label text="1. 账号与权限管理" styleClass="summary-item-title" />
                                    <Label wrapText="true" styleClass="summary-text" text="系统支持管理员、教师和学生三类身份登录。不同身份进入系统后看到的菜单和可执行操作不同，减少误操作，也让用户只关注自己需要处理的业务。" />
                                    <Label text="2. 人员信息管理" styleClass="summary-item-title" />
                                    <Label wrapText="true" styleClass="summary-text" text="管理员可以维护学生和教师基础信息；学生可以查看并维护自己的个人资料；教师可以维护个人简介。照片上传、个人联系方式、班级专业等信息可以为后续教学业务提供基础数据。" />
                                    <Label text="3. 课程与课表管理" styleClass="summary-item-title" />
                                    <Label wrapText="true" styleClass="summary-text" text="课程模块维护课程编号、课程名称、学分、教师等信息；课表模块帮助学生查看课程安排，让学生能够快速了解当前学习计划。" />
                                 </children>
                              </VBox>
                              <VBox spacing="8.0" HBox.hgrow="ALWAYS">
                                 <children>
                                    <Label text="4. 成绩管理" styleClass="summary-item-title" />
                                    <Label wrapText="true" styleClass="summary-text" text="成绩模块支持按学生和课程录入、查询、修改和删除成绩。系统会对不合理分数进行前端弹窗提示，并在后端再次校验，保证成绩数据合法可靠。" />
                                    <Label text="5. 作业中心" styleClass="summary-item-title" />
                                    <Label wrapText="true" styleClass="summary-text" text="教师可以发布作业、上传题图、查看学生提交情况并评分；学生可以查看作业要求、提交文字内容和图片材料。提交状态、评分状态和满分约束都在系统中统一展示。" />
                                    <Label text="6. 请假管理" styleClass="summary-item-title" />
                                    <Label wrapText="true" styleClass="summary-text" text="学生可以提交请假申请，教师可以审核同意或驳回。请假模块把申请原因、时间范围、审批状态和处理意见保存在系统中，方便后续查询。" />
                                 </children>
                              </VBox>
                              <VBox spacing="8.0" HBox.hgrow="ALWAYS">
                                 <children>
                                    <Label text="7. 账号申请审核" styleClass="summary-item-title" />
                                    <Label wrapText="true" styleClass="summary-text" text="新用户可以提交账号申请，管理员在申请列表中查看详情，并对待审核记录执行同意或驳回操作，保证账号进入系统前经过必要确认。" />
                                    <Label text="8. 校园社区" styleClass="summary-item-title" />
                                    <Label wrapText="true" styleClass="summary-text" text="社区模块提供帖子发布、评论互动和内容删除等能力，适合课程讨论、校园通知、学习经验分享等轻量交流场景。" />
                                    <Label text="9. 统计分析与智能助手" styleClass="summary-item-title" />
                                    <Label wrapText="true" styleClass="summary-text" text="统计模块汇总成绩、作业、请假等学习过程数据；智能助手可以根据系统已有数据回答概况查询、对象查询和对比分析类问题。" />
                                 </children>
                              </VBox>
                           </children>
                        </HBox>
                     </children>
                  </VBox>

                  <HBox spacing="16.0">
                     <children>
                        <VBox spacing="10.0" styleClass="summary-panel" HBox.hgrow="ALWAYS">
                           <children>
                              <Label text="四、典型业务流程" styleClass="summary-section-title" />
                              <Label wrapText="true" styleClass="summary-flow" text="登录系统 → 根据身份加载菜单 → 进入对应业务页面 → 查询或选择数据 → 新增、修改、删除、提交或审批 → 后端校验业务规则 → 数据写入数据库 → 前端刷新列表并显示操作结果。" />
                              <Label wrapText="true" styleClass="summary-text" text="例如作业业务中，教师先创建作业并设置满分，学生提交作业后形成提交记录，教师在学生提交列表中查看内容并评分。系统会根据提交内容、提交时间和评分结果显示“未提交、已提交、已评分”等状态。" />
                              <Label wrapText="true" styleClass="summary-text" text="例如账号申请业务中，新用户先填写注册申请，管理员进入申请列表查看待审核记录，点击同意后系统创建正式账号，点击驳回则保留申请记录并标记为已驳回。" />
                           </children>
                        </VBox>
                        <VBox spacing="10.0" styleClass="summary-panel" HBox.hgrow="ALWAYS">
                           <children>
                              <Label text="五、技术架构" styleClass="summary-section-title" />
                              <Label text="前端层：java-fx1" styleClass="summary-item-title" />
                              <Label wrapText="true" styleClass="summary-text" text="使用 JavaFX 构建桌面客户端，FXML 描述界面结构，Controller 处理用户操作，CSS 统一页面风格和深浅主题。" />
                              <Label text="接口层：HTTP JSON" styleClass="summary-item-title" />
                              <Label wrapText="true" styleClass="summary-text" text="前端通过统一的 HttpRequestUtil 调用后端接口，使用 DataRequest 和 DataResponse 封装请求参数、返回数据、状态码和提示信息。" />
                              <Label text="后端层：java-server1" styleClass="summary-item-title" />
                              <Label wrapText="true" styleClass="summary-text" text="使用 Spring Boot 组织 Controller、Service、Repository 和 Model。Controller 暴露接口，Service 处理业务规则，Repository 负责数据库访问，Model 对应数据库表结构。" />
                              <Label text="数据层：MySQL" styleClass="summary-item-title" />
                              <Label wrapText="true" styleClass="summary-text" text="系统将用户、学生、教师、课程、成绩、作业、请假、社区和统计结果等信息持久化保存，便于长期测试和业务追踪。" />
                           </children>
                        </VBox>
                     </children>
                  </HBox>

                  <VBox spacing="10.0" styleClass="summary-panel">
                     <children>
                        <Label text="六、设计特点" styleClass="summary-section-title" />
                        <HBox spacing="16.0">
                           <children>
                              <VBox spacing="6.0" HBox.hgrow="ALWAYS">
                                 <children>
                                    <Label text="统一入口" styleClass="summary-item-title" />
                                    <Label wrapText="true" styleClass="summary-text" text="所有模块都从主界面菜单进入，用户不需要记忆接口地址或数据库结构，只需按业务名称选择页面。" />
                                    <Label text="统一主题" styleClass="summary-item-title" />
                                    <Label wrapText="true" styleClass="summary-text" text="系统支持默认模式、深色模式和紧凑模式，尽量让学生端、教师端和管理端保持一致的视觉体验。" />
                                 </children>
                              </VBox>
                              <VBox spacing="6.0" HBox.hgrow="ALWAYS">
                                 <children>
                                    <Label text="双层校验" styleClass="summary-item-title" />
                                    <Label wrapText="true" styleClass="summary-text" text="关键数据在前端先进行输入提示，后端再进行业务校验。例如成绩、作业满分、作业评分等数据都不会只依赖前端判断。" />
                                    <Label text="测试友好" styleClass="summary-item-title" />
                                    <Label wrapText="true" styleClass="summary-text" text="数据库中准备了多类身份账号以及课程、成绩、作业、请假、社区和统计等测试数据，方便在演示和验收时覆盖不同操作路径。" />
                                 </children>
                              </VBox>
                              <VBox spacing="6.0" HBox.hgrow="ALWAYS">
                                 <children>
                                    <Label text="易扩展" styleClass="summary-item-title" />
                                    <Label wrapText="true" styleClass="summary-text" text="新模块可以按照“FXML 页面、Controller、后端 Controller、Service、Repository、Model”的结构继续扩展，已有菜单机制也能把新页面接入主界面。" />
                                    <Label text="过程可追踪" styleClass="summary-item-title" />
                                    <Label wrapText="true" styleClass="summary-text" text="系统不只保存最终结果，也保留申请、提交、审批、评分和评论等过程数据，便于还原教学管理中的实际业务流转。" />
                                 </children>
                              </VBox>
                           </children>
                        </HBox>
                     </children>
                  </VBox>

                  <VBox spacing="10.0" styleClass="summary-panel summary-footer">
                     <children>
                        <Label text="七、使用说明" styleClass="summary-section-title" />
                        <Label wrapText="true" styleClass="summary-text"
                               text="建议测试时分别使用管理员、教师和学生账号登录，依次验证账号申请审核、学生与教师信息维护、课程管理、成绩录入、作业发布与提交、请假申请与审批、校园社区互动、学生统计和智能助手问答。这样可以完整展示系统在不同身份下的菜单差异、权限控制和业务闭环。" />
                        <Region prefHeight="2.0" />
                        <Label text="当前页面用于系统演示、课程答辩和项目验收中的总体说明。" styleClass="summary-note" wrapText="true" />
                     </children>
                  </VBox>
               </children>
               <padding>
                  <Insets top="18.0" right="18.0" bottom="18.0" left="18.0" />
               </padding>
            </VBox>
         </content>
      </ScrollPane>
   </center>
</BorderPane>
