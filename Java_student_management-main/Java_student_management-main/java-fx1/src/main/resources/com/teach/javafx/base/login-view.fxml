<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<ScrollPane fitToHeight="true"
            fitToWidth="true"
            hbarPolicy="NEVER"
            pannable="true"
            vbarPolicy="AS_NEEDED"
            style="-fx-background: transparent; -fx-background-color: transparent;"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.teach.javafx.controller.base.LoginController">

    <content>
        <StackPane fx:id="rootPane"
                   alignment="TOP_CENTER"
                   styleClass="login-root">

            <children>
                <VBox prefHeight="800.0"
                      prefWidth="1200.0"
                      styleClass="login-bg-layer"/>

                <VBox alignment="CENTER"
                      spacing="20.0"
                      styleClass="login-card"
                      maxWidth="460.0">

                    <StackPane.margin>
                        <Insets top="50.0" right="0.0" bottom="120.0" left="0.0"/>
                    </StackPane.margin>

                    <padding>
                        <Insets top="28.0" right="28.0" bottom="28.0" left="28.0"/>
                    </padding>

                    <children>
                        <VBox alignment="CENTER" spacing="12.0">
                            <children>
                                <Label text="SMART CAMPUS PORTAL" styleClass="eyebrow-label"/>

                                <ImageView fitHeight="90.0"
                                           fitWidth="110.0"
                                           pickOnBounds="true"
                                           preserveRatio="true"
                                           styleClass="logo-image">
                                    <image>
                                        <Image url="@../picture/logo.jpg"/>
                                    </image>
                                </ImageView>

                                <Label text="教学管理系统" styleClass="login-title"/>
                                <Label text="选择身份快速登录，或进入注册与申请流程。" styleClass="login-subtitle"/>

                                <HBox alignment="CENTER" spacing="8.0">
                                    <children>
                                        <Label text="学生" styleClass="feature-pill"/>
                                        <Label text="教师" styleClass="feature-pill"/>
                                        <Label text="管理员" styleClass="feature-pill"/>
                                    </children>
                                </HBox>
                            </children>
                        </VBox>

                        <VBox spacing="14.0" alignment="CENTER" maxWidth="320.0">
                            <children>
                                <VBox spacing="6.0">
                                    <children>
                                        <Label text="登录账号" styleClass="field-label"/>
                                        <TextField fx:id="usernameField"
                                                   promptText="输入账号；留空时将使用默认测试账号"
                                                   styleClass="login-input"/>
                                    </children>
                                </VBox>

                                <VBox spacing="6.0">
                                    <children>
                                        <Label text="登录密码" styleClass="field-label"/>
                                        <PasswordField fx:id="passwordField"
                                                       promptText="输入密码；留空时默认使用 123456"
                                                       styleClass="login-input"/>
                                    </children>
                                </VBox>
                            </children>
                        </VBox>

                        <VBox alignment="CENTER" spacing="12.0" maxWidth="320.0">
                            <children>
                                <Button text="管理员登录"
                                        onAction="#onAdminLoginButtonClick"
                                        maxWidth="Infinity"
                                        styleClass="login-btn-primary"/>

                                <HBox spacing="10.0" alignment="CENTER">
                                    <children>
                                        <Button text="学生登录"
                                                onAction="#onStudentLoginButtonClick"
                                                HBox.hgrow="ALWAYS"
                                                maxWidth="Infinity"
                                                styleClass="login-btn-secondary"/>

                                        <Button text="教师登录"
                                                onAction="#onTeacherLoginButtonClick"
                                                HBox.hgrow="ALWAYS"
                                                maxWidth="Infinity"
                                                styleClass="login-btn-secondary"/>
                                    </children>
                                </HBox>

                                <HBox spacing="10.0" alignment="CENTER">
                                    <children>
                                        <Button text="学生注册"
                                                onAction="#onStudentRegisterButtonClick"
                                                HBox.hgrow="ALWAYS"
                                                maxWidth="Infinity"
                                                styleClass="login-btn-secondary"/>

                                        <Button text="教师申请注册"
                                                onAction="#onTeacherApplyButtonClick"
                                                HBox.hgrow="ALWAYS"
                                                maxWidth="Infinity"
                                                styleClass="login-btn-secondary"/>
                                    </children>
                                </HBox>

                                <Button text="管理员申请注册"
                                        onAction="#onAdminApplyButtonClick"
                                        maxWidth="Infinity"
                                        styleClass="login-btn-secondary"/>
                            </children>
                        </VBox>

                        <Label text="当前界面支持默认测试账号快速进入；如果你已经分配了正式账号，也可以直接输入账号密码登录。"
                               wrapText="true"
                               styleClass="footer-text"/>
                    </children>
                </VBox>
            </children>
        </StackPane>
    </content>
</ScrollPane>
