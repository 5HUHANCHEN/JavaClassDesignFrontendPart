<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.teach.javafx.controller.base.ApplyRegisterController"
           styleClass="apply-root">

    <VBox alignment="CENTER" spacing="20.0">
        <children>
            <Label fx:id="pageTitleLabel" text="注册申请" styleClass="page-title"/>
            <Label fx:id="pageHintLabel" text="请填写完整的申请资料。" styleClass="login-subtitle"/>

            <VBox spacing="12.0" styleClass="apply-card" maxWidth="420.0">
                <padding>
                    <Insets top="20.0" right="20.0" bottom="20.0" left="20.0"/>
                </padding>
                <children>
                    <TextField fx:id="usernameField" promptText="请输入申请账号" styleClass="neo-input"/>
                    <TextField fx:id="nameField" promptText="请输入申请人姓名" styleClass="neo-input"/>
                    <TextField fx:id="emailField" promptText="请输入电子邮箱" styleClass="neo-input"/>
                    <TextField fx:id="deptField" promptText="请输入所在院系" styleClass="neo-input"/>
                    <TextField fx:id="majorField" promptText="请输入专业信息" styleClass="neo-input"/>
                    <TextField fx:id="classNameField" promptText="请输入班级或岗位信息" styleClass="neo-input"/>
                    <TextField fx:id="phoneField" promptText="请输入联系电话" styleClass="neo-input"/>
                    <PasswordField fx:id="passwordField" promptText="请输入登录密码" styleClass="neo-input"/>
                    <PasswordField fx:id="confirmPasswordField" promptText="请再次输入登录密码" styleClass="neo-input"/>
                    <TextArea fx:id="reasonTextArea"
                              promptText="请输入申请说明，例如教学、管理或测试用途"
                              prefRowCount="4"
                              wrapText="true"
                              styleClass="neo-input"/>

                    <HBox alignment="CENTER" spacing="10.0">
                        <children>
                            <Button text="提交申请"
                                    onAction="#onSubmitButtonClick"
                                    styleClass="neo-btn-primary"/>
                            <Button text="返回登录"
                                    onAction="#onBackButtonClick"
                                    styleClass="neo-btn-light"/>
                        </children>
                    </HBox>
                </children>
            </VBox>
        </children>
    </VBox>
</StackPane>