<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="15.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.teach.javafx.controller.CourseAddController">
    <padding>
        <Insets bottom="15.0" left="25.0" right="25.0" top="15.0"/>
    </padding>
    <Label fx:id="dialogTitleLabel" text="新增课表课程" style="-fx-font-size: 16px; -fx-font-weight: bold;"/>
    <GridPane hgap="10.0" vgap="10.0">
        <columnConstraints>
            <ColumnConstraints halignment="RIGHT" hgrow="SOMETIMES" minWidth="90.0" prefWidth="90.0"/>
            <ColumnConstraints hgrow="SOMETIMES" minWidth="180.0" prefWidth="180.0"/>
        </columnConstraints>
        <rowConstraints>
            <RowConstraints minHeight="30.0" prefHeight="30.0" vgrow="SOMETIMES"/>
            <RowConstraints minHeight="30.0" prefHeight="30.0" vgrow="SOMETIMES"/>
            <RowConstraints minHeight="30.0" prefHeight="30.0" vgrow="SOMETIMES"/>
            <RowConstraints minHeight="30.0" prefHeight="30.0" vgrow="SOMETIMES"/>
            <RowConstraints minHeight="30.0" prefHeight="30.0" vgrow="SOMETIMES"/>
        </rowConstraints>
        <children>
            <Label text="课程名称：" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
            <TextField fx:id="courseNameField" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
            <Label text="星期几：" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
            <ComboBox fx:id="dayOfWeekComboBox" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
            <Label text="时间段：" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
            <ComboBox fx:id="timeSlotComboBox" GridPane.columnIndex="1" GridPane.rowIndex="2"/>
            <Label text="开始周：" GridPane.columnIndex="0" GridPane.rowIndex="3"/>
            <TextField fx:id="startWeekField" GridPane.columnIndex="1" GridPane.rowIndex="3"/>
            <Label text="结束周：" GridPane.columnIndex="0" GridPane.rowIndex="4"/>
            <TextField fx:id="stopWeekField" GridPane.columnIndex="1" GridPane.rowIndex="4"/>
        </children>
    </GridPane>
    <FlowPane alignment="CENTER" prefHeight="40.0" prefWidth="300.0">
        <children>
            <Button mnemonicParsing="false" onAction="#okButtonClick" text="确认保存">
                <FlowPane.margin>
                    <Insets right="15.0"/>
                </FlowPane.margin>
            </Button>
            <Button mnemonicParsing="false" onAction="#cancelButtonClick" text="取消">
                <FlowPane.margin>
                    <Insets left="15.0"/>
                </FlowPane.margin>
            </Button>
        </children>
    </FlowPane>
</VBox>
