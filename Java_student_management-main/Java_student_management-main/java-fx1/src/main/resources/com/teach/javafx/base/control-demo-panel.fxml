<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ChoiceBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.teach.javafx.controller.base.ControlDemoController" styleClass="module-root">
   <top>
      <VBox spacing="12.0">
         <children>
            <HBox alignment="CENTER_LEFT" spacing="12.0" styleClass="module-toolbar">
               <children>
                  <VBox spacing="4.0">
                     <children>
                        <Label text="组件示例" styleClass="module-title" />
                        <Label text="展示常用输入组件、列表组件和操作按钮，方便统一检查主题效果。" styleClass="module-subtitle" />
                     </children>
                  </VBox>
               </children>
            </HBox>
         </children>
         <padding>
            <Insets top="16.0" right="16.0" bottom="10.0" left="16.0" />
         </padding>
      </VBox>
   </top>
   <center>
      <HBox spacing="16.0">
         <children>
            <VBox spacing="14.0" styleClass="demo-group" HBox.hgrow="ALWAYS">
               <children>
                  <Label text="基础输入" styleClass="demo-title" />
                  <GridPane hgap="12.0" vgap="12.0">
                     <columnConstraints>
                        <ColumnConstraints prefWidth="90.0" />
                        <ColumnConstraints hgrow="ALWAYS" />
                     </columnConstraints>
                     <children>
                        <Label text="文本输入" GridPane.rowIndex="0" />
                        <TextField GridPane.columnIndex="1" GridPane.rowIndex="0" />
                        <Label text="密码" GridPane.rowIndex="1" />
                        <PasswordField GridPane.columnIndex="1" GridPane.rowIndex="1" />
                        <Label text="选择列表" GridPane.rowIndex="2" />
                        <ChoiceBox fx:id="choiceBox" prefWidth="180.0" GridPane.columnIndex="1" GridPane.rowIndex="2" />
                        <Label text="下拉列表" GridPane.rowIndex="3" />
                        <ComboBox fx:id="comboBox" prefWidth="180.0" GridPane.columnIndex="1" GridPane.rowIndex="3" />
                        <Label text="多行文本" GridPane.rowIndex="4" />
                        <TextArea prefHeight="110.0" prefWidth="220.0" GridPane.columnIndex="1" GridPane.rowIndex="4" />
                     </children>
                  </GridPane>
               </children>
            </VBox>
            <VBox spacing="14.0" styleClass="demo-group" HBox.hgrow="ALWAYS">
               <children>
                  <Label text="交互与选择" styleClass="demo-title" />
                  <HBox spacing="12.0">
                     <children>
                        <RadioButton fx:id="maleRadio" mnemonicParsing="false" text="男" />
                        <RadioButton fx:id="femaleRadio" mnemonicParsing="false" text="女" />
                     </children>
                  </HBox>
                  <HBox spacing="12.0">
                     <children>
                        <CheckBox mnemonicParsing="false" text="多选一" />
                        <CheckBox mnemonicParsing="false" text="多选二" />
                     </children>
                  </HBox>
                  <ListView fx:id="listView" prefHeight="180.0" prefWidth="220.0" />
                  <Hyperlink text="超链接示例" />
                  <Button fx:id="button" mnemonicParsing="false" onAction="#onButtonClick" styleClass="btn-primary" text="示例按钮" />
               </children>
            </VBox>
         </children>
         <padding>
            <Insets top="0.0" right="16.0" bottom="16.0" left="16.0" />
         </padding>
      </HBox>
   </center>
</BorderPane>
