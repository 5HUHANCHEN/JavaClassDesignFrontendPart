<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.MenuBar?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TreeView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane fx:id="rootPane" prefHeight="760.0" prefWidth="1280.0" styleClass="main-root" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.teach.javafx.controller.base.MainFrameController">

  <top>
    <VBox spacing="12.0" styleClass="top-area">
      <children>
        <HBox alignment="CENTER_LEFT" spacing="16.0" styleClass="header-card">
          <children>
            <VBox spacing="4.0">
              <children>
                <Label styleClass="app-title" text="教学管理系统" />
                <Label styleClass="app-subtitle" text="JavaFX + Spring Boot + MySQL 教学管理平台" />
              </children>
            </VBox>

            <HBox HBox.hgrow="ALWAYS" />

            <VBox alignment="CENTER_RIGHT" spacing="4.0" styleClass="theme-box">
              <children>
                <Label styleClass="small-label" text="账号类型" />
                <ComboBox fx:id="switchRoleComboBox" prefWidth="120.0" styleClass="theme-combo" />
              </children>
            </VBox>

            <VBox alignment="CENTER_RIGHT" spacing="4.0" styleClass="theme-box">
              <children>
                <Label styleClass="small-label" text="切换账号" />
                <ComboBox fx:id="switchAccountComboBox" prefWidth="190.0" styleClass="theme-combo" />
              </children>
            </VBox>

            <VBox alignment="CENTER_RIGHT" spacing="4.0" styleClass="theme-box">
              <children>
                <Label styleClass="small-label" text="界面模式" />
                <ComboBox fx:id="themeComboBox" prefWidth="150.0" styleClass="theme-combo" />
              </children>
            </VBox>

            <Button onAction="#onLogoutMenuClick" styleClass="logout-button" text="退出登录" />
          </children>
        </HBox>

        <HBox alignment="CENTER_LEFT" spacing="10.0" styleClass="menubar-card">
          <children>
            <MenuBar fx:id="menuBar" HBox.hgrow="ALWAYS" />
          </children>
        </HBox>
      </children>
      <padding>
        <Insets bottom="10.0" left="18.0" right="18.0" top="18.0" />
      </padding>
    </VBox>
  </top>

  <left>
    <VBox spacing="10.0" styleClass="left-area">
      <children>
        <Label styleClass="nav-title" text="功能导航" />

        <VBox styleClass="nav-card" VBox.vgrow="ALWAYS">
          <children>
            <TreeView fx:id="menuTree" prefWidth="230.0" styleClass="menu-tree" VBox.vgrow="ALWAYS" />
          </children>
        </VBox>
      </children>
      <padding>
        <Insets bottom="12.0" left="18.0" right="0.0" top="0.0" />
      </padding>
    </VBox>
  </left>

  <center>
    <VBox styleClass="center-area">
      <children>
        <TabPane fx:id="contentTabPane" styleClass="content-tabs" tabClosingPolicy="ALL_TABS" VBox.vgrow="ALWAYS" />
      </children>
      <padding>
        <Insets bottom="12.0" left="12.0" right="18.0" top="0.0" />
      </padding>
    </VBox>
  </center>

  <bottom>
    <HBox alignment="CENTER_LEFT" spacing="8.0" styleClass="status-card">
      <children>
        <Label styleClass="status-title" text="系统信息：" />
        <Label fx:id="systemPrompt" styleClass="status-text" text="服务器：    数据库：" />
        <Label styleClass="status-text" text="团队编号：" />
        <Label styleClass="status-text" text="20" />
        <Label styleClass="status-text" text="团队成员：" />
        <Label styleClass="status-text" text="王玉玺 202500550516 孙召轩 202500550472 汤沐 202522550490 陈书涵 202500550577" />
        <HBox HBox.hgrow="ALWAYS" />
        <Label fx:id="rightStatusLabel" styleClass="status-text-right" text="欢迎使用" />
      </children>
      <padding>
        <Insets bottom="12.0" left="18.0" right="18.0" top="8.0" />
      </padding>
    </HBox>
  </bottom>

</BorderPane>
