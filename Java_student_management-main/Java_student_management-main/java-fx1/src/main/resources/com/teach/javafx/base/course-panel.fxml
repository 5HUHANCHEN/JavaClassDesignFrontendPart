<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.teach.javafx.controller.CourseController"
            prefHeight="520.0" prefWidth="960.0"
            styleClass="module-root">
    <top>
        <VBox spacing="10.0" BorderPane.alignment="CENTER">
            <padding>
                <Insets top="14.0" right="14.0" bottom="10.0" left="14.0"/>
            </padding>
            <HBox spacing="10.0" alignment="CENTER_LEFT" styleClass="module-toolbar">
                <Label text="课程管理" styleClass="module-title"/>
                <TextField fx:id="numNameTextField" promptText="输入课程编号或课程名称" prefWidth="260.0"/>
                <Button text="查询课程" onAction="#onQueryButtonClick" styleClass="btn-secondary"/>
                <Button text="新增课程" onAction="#onAddButtonClick" styleClass="btn-primary"/>
                <Button text="课表管理" onAction="#onOpenScheduleButtonClick" styleClass="btn-secondary"/>
            </HBox>
            <HBox styleClass="module-status-bar">
                <children>
                    <Label text="状态：" styleClass="module-status-label"/>
                    <Label fx:id="statusLabel" text="课程管理页面已就绪。" styleClass="module-status-text"/>
                </children>
            </HBox>
        </VBox>
    </top>
    <center>
        <VBox styleClass="module-content-card" BorderPane.alignment="CENTER">
            <padding>
                <Insets top="8.0" right="10.0" bottom="10.0" left="10.0"/>
            </padding>
            <children>
                <TableView fx:id="dataTableView" editable="true">
                    <columns>
                        <TableColumn fx:id="numColumn" prefWidth="130.0" text="课程编号"/>
                        <TableColumn fx:id="nameColumn" prefWidth="150.0" text="课程名称"/>
                        <TableColumn fx:id="creditColumn" prefWidth="90.0" text="学分"/>
                        <TableColumn fx:id="coursePathColumn" prefWidth="130.0" text="课程路径"/>
                        <TableColumn fx:id="preCourseColumn" prefWidth="180.0" text="前置课程"/>
                        <TableColumn fx:id="operateColumn" prefWidth="180.0" text="操作"/>
                    </columns>
                </TableView>
            </children>
        </VBox>
    </center>
</BorderPane>
