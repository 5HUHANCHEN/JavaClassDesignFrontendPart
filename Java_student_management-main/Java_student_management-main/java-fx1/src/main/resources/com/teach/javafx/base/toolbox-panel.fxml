<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="760.0" prefWidth="1180.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.teach.javafx.controller.ToolboxController">
    <styleClass>
        <String fx:value="module-root" />
        <String fx:value="toolbox-root" />
    </styleClass>
    <top>
        <VBox spacing="6.0" styleClass="toolbox-header">
            <padding>
                <Insets bottom="12.0" left="22.0" right="22.0" top="18.0" />
            </padding>
            <Label styleClass="module-title" text="百宝箱" />
            <Label styleClass="module-subtitle" text="把常用、有趣、临时能救急的网站整理成一页工具入口，点击即可用系统浏览器打开。" wrapText="true" />
        </VBox>
    </top>
    <center>
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="toolbox-scroll">
            <content>
                <VBox fx:id="toolboxListBox" spacing="12.0" styleClass="toolbox-list">
                    <padding>
                        <Insets bottom="22.0" left="22.0" right="22.0" top="16.0" />
                    </padding>
                </VBox>
            </content>
        </ScrollPane>
    </center>
</BorderPane>
