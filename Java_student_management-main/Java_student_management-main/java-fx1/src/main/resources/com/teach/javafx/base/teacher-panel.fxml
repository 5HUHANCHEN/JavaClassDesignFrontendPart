<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane fx:id="rootPane" prefHeight="680.0" prefWidth="1100.0" styleClass="module-root" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.teach.javafx.controller.TeacherController">
    <top>
        <VBox spacing="14.0" styleClass="top-wrapper">
            <children>
                <HBox alignment="CENTER_LEFT" spacing="16.0" styleClass="module-toolbar">
                    <children>
                        <VBox spacing="4.0">
                            <children>
                                <Label styleClass="page-title" text="教师信息管理" />
                                <Label styleClass="page-subtitle" text="统一跟随系统界面模式，支持查询、编辑、保存、删除与头像上传。" />
                            </children>
                        </VBox>

                        <HBox HBox.hgrow="ALWAYS" />

                        <Label styleClass="module-label" text="全局主题已接管当前页面" />
                    </children>
                </HBox>

                <HBox alignment="CENTER_LEFT" spacing="12.0" styleClass="module-filter-bar">
                    <children>
                        <Button onAction="#onAddButtonClick" styleClass="btn-primary" text="新增一行" />
                        <Button onAction="#onQueryButtonClick" styleClass="btn-secondary" text="刷新" />
                        <FlowPane HBox.hgrow="ALWAYS" />
                        <Label styleClass="query-label" text="工号 / 姓名" />
                        <TextField fx:id="numNameTextField" prefWidth="180.0" promptText="请输入工号或姓名" styleClass="query-field" />
                        <Button onAction="#onQueryButtonClick" styleClass="btn-primary" text="查询" />
                    </children>
                </HBox>

                <HBox alignment="CENTER_LEFT" spacing="8.0" styleClass="module-status-bar">
                    <children>
                        <Label styleClass="status-title" text="状态：" />
                        <Label fx:id="statusLabel" styleClass="status-text" text="系统就绪" />
                    </children>
                </HBox>
            </children>
            <padding>
                <Insets bottom="10.0" left="18.0" right="18.0" top="18.0" />
            </padding>
        </VBox>
    </top>

    <center>
        <VBox styleClass="module-content-card">
            <children>
                <TableView fx:id="dataTableView" editable="true" styleClass="teacher-table" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="numColumn" prefWidth="140.0" text="工号" />
                        <TableColumn fx:id="nameColumn" prefWidth="140.0" text="姓名" />
                        <TableColumn fx:id="deptColumn" prefWidth="220.0" text="院系" />
                        <TableColumn fx:id="titleColumn" prefWidth="150.0" text="职称" />
                        <TableColumn fx:id="degreeColumn" prefWidth="150.0" text="学历" />
                        <TableColumn fx:id="operateColumn" prefWidth="260.0" text="操作" />
                    </columns>
                </TableView>
            </children>
            <padding>
                <Insets bottom="18.0" left="18.0" right="18.0" top="0.0" />
            </padding>
        </VBox>
    </center>
</BorderPane>
