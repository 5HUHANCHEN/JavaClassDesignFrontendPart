<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.teach.javafx.controller.EntertainmentCenterController">
    <styleClass>
        <String fx:value="module-root" />
        <String fx:value="entertainment-root" />
    </styleClass>
    <top>
        <VBox spacing="6" styleClass="entertainment-header">
            <padding>
                <Insets top="18" right="22" bottom="12" left="22" />
            </padding>
            <Label styleClass="module-title" text="娱乐资讯中心" />
            <Label styleClass="module-subtitle" text="天气、一言、电影、音乐、文案、星座与今日热榜都从后端统一代理获取，外部接口失败时会自动显示本地降级内容。" wrapText="true" />
        </VBox>
    </top>
    <center>
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="entertainment-scroll">
            <content>
                <VBox spacing="14" styleClass="entertainment-content">
                    <padding>
                        <Insets top="14" right="22" bottom="22" left="22" />
                    </padding>
                    <HBox spacing="14">
                        <VBox spacing="10" styleClass="entertainment-card" HBox.hgrow="ALWAYS">
                            <Label styleClass="card-title" text="天气 + 今日建议" />
                            <HBox spacing="8">
                                <TextField fx:id="cityTextField" promptText="城市，例如：北京" HBox.hgrow="ALWAYS" />
                                <Button onAction="#onWeatherQueryClick" styleClass="btn-primary" text="查询" />
                            </HBox>
                            <Label fx:id="weatherTitleLabel" styleClass="highlight-title" text="今日天气" wrapText="true" />
                            <TextArea fx:id="weatherTextArea" editable="false" prefRowCount="6" wrapText="true" />
                        </VBox>
                        <VBox spacing="10" styleClass="entertainment-card" HBox.hgrow="ALWAYS">
                            <Label styleClass="card-title" text="每日一言" />
                            <Label fx:id="hitokotoContentLabel" styleClass="quote-label" text="正在获取一句话..." wrapText="true" />
                            <Label fx:id="hitokotoMetaLabel" styleClass="muted-label" text="出处" wrapText="true" />
                            <Button onAction="#onHitokotoRefreshClick" styleClass="btn-secondary" text="换一句" />
                        </VBox>
                    </HBox>
                    <HBox spacing="14">
                        <VBox spacing="10" styleClass="entertainment-card" HBox.hgrow="ALWAYS">
                            <Label styleClass="card-title" text="电影推荐" />
                            <Label fx:id="movieFeaturedLabel" styleClass="highlight-title" text="正在获取电影推荐..." wrapText="true" />
                            <TextArea fx:id="movieListArea" editable="false" prefRowCount="9" wrapText="true" />
                            <Label fx:id="movieUrlLabel" styleClass="link-label" text="暂无链接" wrapText="true" />
                            <FlowPane hgap="8" vgap="8">
                                <ComboBox fx:id="movieModeComboBox" minWidth="120" prefWidth="120" />
                                <TextField fx:id="movieKeywordTextField" prefWidth="130" promptText="电影关键词" />
                                <ComboBox fx:id="movieChannelComboBox" minWidth="205" prefWidth="205" />
                                <Button onAction="#onMovieRefreshClick" styleClass="btn-secondary" text="刷新电影" />
                                <Button onAction="#onMovieOpenClick" styleClass="btn-primary" text="打开链接" />
                            </FlowPane>
                        </VBox>
                        <VBox spacing="10" styleClass="entertainment-card" HBox.hgrow="ALWAYS">
                            <Label styleClass="card-title" text="音乐推荐" />
                            <Label fx:id="musicNameLabel" styleClass="highlight-title" text="正在获取音乐推荐..." wrapText="true" />
                            <Label fx:id="musicMetaLabel" styleClass="muted-label" text="歌手与榜单" wrapText="true" />
                            <TextArea fx:id="musicListArea" editable="false" prefRowCount="5" wrapText="true" />
                            <Label fx:id="musicUrlLabel" styleClass="link-label" text="暂无链接" wrapText="true" />
                            <FlowPane hgap="8" vgap="8">
                                <ComboBox fx:id="musicModeComboBox" minWidth="120" prefWidth="120" />
                                <TextField fx:id="musicKeywordTextField" prefWidth="130" promptText="音乐关键词" />
                                <ComboBox fx:id="musicChannelComboBox" minWidth="190" prefWidth="190" />
                                <Button onAction="#onMusicRefreshClick" styleClass="btn-secondary" text="换一首" />
                                <Button onAction="#onMusicOpenClick" styleClass="btn-primary" text="打开链接" />
                            </FlowPane>
                        </VBox>
                        <VBox spacing="10" styleClass="entertainment-card" HBox.hgrow="ALWAYS">
                            <Label styleClass="card-title" text="星座运势" />
                            <HBox spacing="8">
                                <ComboBox fx:id="horoscopeComboBox" minWidth="150" prefWidth="150" />
                                <Button onAction="#onHoroscopeRefreshClick" styleClass="btn-primary" text="查看" />
                            </HBox>
                            <TextArea fx:id="horoscopeTextArea" editable="false" prefRowCount="10" wrapText="true" />
                        </VBox>
                    </HBox>
                    <HBox spacing="14">
                        <VBox spacing="10" styleClass="entertainment-card" HBox.hgrow="ALWAYS">
                            <Label styleClass="card-title" text="娱乐文案生成器" />
                            <FlowPane hgap="8" vgap="8">
                                <ComboBox fx:id="copyTypeComboBox" minWidth="190" prefWidth="190" />
                                <TextField fx:id="copyKeywordTextField" prefWidth="220" promptText="关键词，例如：今天" />
                                <Button onAction="#onCopyGenerateClick" styleClass="btn-primary" text="生成" />
                            </FlowPane>
                            <TextArea fx:id="copyResultArea" editable="false" prefRowCount="7" wrapText="true" />
                        </VBox>
                        <VBox spacing="10" styleClass="entertainment-card" HBox.hgrow="ALWAYS">
                            <Label styleClass="card-title" text="今日热榜" />
                            <HBox spacing="8">
                                <ComboBox fx:id="hotCategoryComboBox" minWidth="170" prefWidth="170" />
                                <Button onAction="#onHotListRefreshClick" styleClass="btn-primary" text="刷新热榜" />
                            </HBox>
                            <VBox fx:id="hotListBox" spacing="6" />
                        </VBox>
                    </HBox>
                </VBox>
            </content>
        </ScrollPane>
    </center>
    <bottom>
        <Label fx:id="statusLabel" styleClass="entertainment-status" text="娱乐资讯中心准备中">
            <padding>
                <Insets top="8" right="16" bottom="8" left="16" />
            </padding>
        </Label>
    </bottom>
</BorderPane>
